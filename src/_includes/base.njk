<!doctype html>
<html lang="fr">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{% if title %}{{ title }} · {% endif %}{{ site.nom }} — Nancy</title>
  <meta name="description" content="{{ description or accueil.texte }}">
  <link rel="preload" href="/assets/fonts/cormorant-garamond-latin-600-normal.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="stylesheet" href="/assets/css/style.css">
  <link rel="icon" href="/assets/images/favicon.svg?v=4" type="image/svg+xml">
</head>
<body>
  <a class="skip" href="#contenu">Aller au contenu</a>
  <header class="site-header">
    <div class="wrap header-in">
      <a class="brand" href="/">
        {% include "logo.njk" %}
        <span><strong>{{ site.nom }}</strong><small>Chemin néocatéchuménal · Nancy</small></span>
      </a>
      <button class="nav-toggle" aria-expanded="false" aria-controls="nav">Menu</button>
      <nav id="nav" aria-label="Navigation principale">
        <ul>
          {% set liens = [
            ["/", "Accueil"],
            ["/le-chemin/", "Le Chemin"],
            ["/statut/", "Le Statut"],
            ["/histoire/", "Notre histoire"],
            ["/vie-de-la-paroisse/", "Vie de la paroisse"],
            ["/actualites/", "Actualités"],
            ["/galerie/", "Photos & vidéos"],
            ["/contact/", "Contact"]
          ] %}
          {% for l in liens %}
          <li><a href="{{ l[0] }}"{% if page.url == l[0] or (l[0] != "/" and l[0] in page.url) %} aria-current="page"{% endif %}>{{ l[1] }}</a></li>
          {% endfor %}
        </ul>
      </nav>
    </div>
  </header>

  <main id="contenu">
    {{ content | safe }}
  </main>

  <footer class="site-footer">
    <div class="wrap footer-in">
      <div>
        <p class="footer-nom">{{ site.nom }}</p>
        <p class="pre">{{ site.adresse }}</p>
      </div>
      <div>
        <p><a href="mailto:{{ site.email }}">{{ site.email }}</a><br>{{ site.telephone }}</p>
        <p><a href="https://neocatechumenaleiter.org/fr/" rel="noopener">Site officiel du Chemin néocatéchuménal</a></p>
      </div>
    </div>
  </footer>
  <script>
    const b = document.querySelector('.nav-toggle'), n = document.getElementById('nav');
    b.addEventListener('click', () => {
      const o = n.classList.toggle('open');
      b.setAttribute('aria-expanded', o);
    });
  </script>
  <script src="/assets/js/diaporama.js" defer></script>
</body>
</html>
