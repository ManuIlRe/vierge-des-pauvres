---
layout: base.njk
permalink: /
---
<section class="hero">
  <div class="wrap hero-in">
    <div class="hero-txt">
      <p class="surtitre">{{ site.sous_titre }}</p>
      <h1>{{ site.nom }}</h1>
      {% if accueil.citation %}
      <blockquote>
        <p>«&nbsp;{{ accueil.citation }}&nbsp;»</p>
        {% if accueil.citation_auteur %}<cite>{{ accueil.citation_auteur }}</cite>{% endif %}
      </blockquote>
      {% endif %}
      <p class="actions">
        {% if accueil.bouton_1 %}<a class="btn" href="/le-chemin/">{{ accueil.bouton_1 }}</a>{% endif %}
        {% if accueil.bouton_2 %}<a class="btn btn-clair" href="/contact/">{{ accueil.bouton_2 }}</a>{% endif %}
      </p>
    </div>
    {% if accueil.icone %}
    <figure class="icone">
      <img src="{{ accueil.icone }}" alt="{{ accueil.icone_description }}">
    </figure>
    {% endif %}
  </div>
</section>

{# Les sections s'affichent dans l'ordre choisi dans le panneau (Page d'accueil → Sections) #}
{% for section in accueil.sections %}

{% if section == "intro" %}
<section class="wrap bloc intro">
  {% if accueil.medaillon %}<img class="medaillon" src="{{ accueil.medaillon }}" alt="{{ accueil.medaillon_description }}">{% endif %}
  <p>{{ accueil.texte }}</p>
</section>

{% elif section == "tripode" %}
<section class="bloc tripode-bloc">
  <div class="wrap">
    <h2>{{ accueil.tripode_titre }}</h2>
    <div class="tripode">
      {% for t in accueil.tripode %}
      <div><span>{{ ["I", "II", "III", "IV", "V", "VI"][loop.index0] }}</span><h3>{{ t.titre }}</h3><p>{{ t.texte }}</p></div>
      {% endfor %}
    </div>
  </div>
</section>

{% elif section == "horaires" %}
<section class="wrap bloc deux-col">
  <div>
    <h2>{{ accueil.horaires_titre }}</h2>
    <ul class="horaires">
      {% for h in site.horaires %}
      <li><strong>{{ h.jour }} <span>{{ h.heure }}</span></strong>{{ h.description }}</li>
      {% endfor %}
    </ul>
  </div>
  <div>
    <h2>{{ accueil.acces_titre }}</h2>
    {% if site.photo_eglise %}<img class="photo" src="{{ site.photo_eglise }}" alt="L’église de la Vierge des Pauvres" loading="lazy">{% endif %}
    <p class="pre">{{ site.adresse }}</p>
    <p>Presbytre : {{ site.presbytre }}</p>
    <p><a class="lien-fleche" href="/contact/">Contact et accès →</a></p>
  </div>
</section>

{% elif section == "photos" and galerie.photos.length %}
<section class="wrap bloc">
  <div class="titre-ligne"><h2>{{ accueil.photos_titre }}</h2><a class="lien-fleche" href="/galerie/">Photos & vidéos →</a></div>
  {% set photos = galerie.photos %}{% include "diaporama.njk" %}
</section>

{% elif section == "activites" and collections.activites.length %}
<section class="bloc fond-clair">
  <div class="wrap">
    <div class="titre-ligne"><h2>{{ accueil.activites_titre }}</h2><a class="lien-fleche" href="/activites/">Tout voir →</a></div>
    <div class="cartes">
      {% for a in collections.activites | limit(accueil.activites_nombre or 3) %}{% include "carte-activite.njk" %}{% endfor %}
    </div>
  </div>
</section>
{% endif %}

{% endfor %}
