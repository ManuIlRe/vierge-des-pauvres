---
layout: page.njk
title: Contact et accès
permalink: /contact/
large: true
---
<div class="deux-col">
  <div>
    {% if site.photo_eglise %}<img class="photo" src="{{ site.photo_eglise }}" alt="L’église de la Vierge des Pauvres">{% endif %}
    <h2>Adresse</h2>
    <p class="pre">{{ site.adresse }}</p>
    {% if site.transport %}<p>{{ site.transport }}</p>{% endif %}
    <p><a class="btn btn-contour" href="{{ site.lien_carte }}" rel="noopener">Voir sur la carte</a></p>
    <h2>Nous écrire</h2>
    <p><a href="mailto:{{ site.email }}">{{ site.email }}</a><br>{{ site.telephone }}</p>
    <p>Presbytre : {{ site.presbytre }}</p>
  </div>
  <div>
    <h2>Horaires</h2>
    <ul class="horaires">
      {% for h in site.horaires %}
      <li><strong>{{ h.jour }} <span>{{ h.heure }}</span></strong>{{ h.description }}</li>
      {% endfor %}
    </ul>
    {% if site.vignette_contact %}<figure class="vignette"><img src="{{ site.vignette_contact }}" alt="{{ site.vignette_contact_legende }}" loading="lazy">{% if site.vignette_contact_legende %}<figcaption>{{ site.vignette_contact_legende }}</figcaption>{% endif %}</figure>{% endif %}
  </div>
</div>
